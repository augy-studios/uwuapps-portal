# telegram-bot/.env.example
#
# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
#
# .env is git ignored. This file is committed, so never put a real value in it.
#
# config.py validates all of this at startup and exits naming the key that is
# missing, so a typo fails immediately rather than inside a handler hours later.
#
# Four of these values also have to be set in the Vercel environment. See
# main-site/.env.example and SETUP.md step 10.


# --- Telegram, required -------------------------------------------------------

# Where to find them: open https://my.telegram.org, sign in with your phone
# number, choose "API development tools", and fill in any app name and short
# name. The page then shows App api_id and App api_hash.
#
# These belong to your Telegram account, not to the bot, and Telethon needs them
# even in bot mode. Treat them as secrets: they are not recoverable if leaked,
# only replaceable by contacting Telegram.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=00000000000000000000000000000000

# Where to find it: message @BotFather in Telegram, send /newbot, choose a
# display name and a username, and copy the token it hands back. If you lose it,
# /token in the same chat shows it again, and /revoke replaces it.
#
# Anyone holding this token is the bot. The same value also goes in the Vercel
# environment, because the portal sends the approval prompt and the sign in code
# itself through the Bot API. That is the tradeoff for the VPS needing no inbound
# port and no public hostname.
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# --- Portal, required ---------------------------------------------------------

# The canonical origin of the portal, no trailing slash. Every API call is made
# against this host, and the request signature covers the path, so getting the
# host wrong shows up as a 403 rather than a connection error.
PORTAL_BASE_URL=https://uwuapps.org

# Where the "Open the web app" button points. Usually the same as above, but
# kept separate so the buttons can point at a landing page while the API calls
# go somewhere else.
PORTAL_WEB_APP_URL=https://uwuapps.org

# Where the "Support the project" button points. The default is the Stripe link
# already in the site footer, main-site/index.html.
DONATION_URL=https://donate.stripe.com/28o2akeAr3hv0DK6oo

# How to make it: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then set TELEGRAM_BOT_SHARED_SECRET on Vercel to the identical value. This is
# what proves to the portal that a call really came from here. If the two differ,
# every /link and /code answers with a 403 while /browse keeps working, because
# reads need no credentials.
TELEGRAM_BOT_SHARED_SECRET=replace_me_with_64_hex_characters


# --- Optional -----------------------------------------------------------------

# Which Telegram accounts may run the admin commands, currently /stats.
# How to find your own id: message @userinfobot, or run /status here and read
# the id off the log line in logs/bot.log. Comma separated, no spaces needed.
# Leave empty and nobody has admin access, which is a safe default.
ADMIN_TELEGRAM_IDS=

# Where unhandled errors are reported. A user id for a direct message, or a
# negative id for a group. How to find a group id: add the bot to the group and
# read the chat id off the log line, or use @userinfobot inside the group.
# Leave empty and errors go only to logs/bot.log.
ADMIN_CHAT_ID=

# Where the SQLite file lives. Relative paths are resolved against this
# directory. The parent is created automatically, and the Telethon session file
# is written beside it. Both are git ignored.
DB_PATH=./data/bot.db

# One of DEBUG, INFO, WARNING, ERROR. DEBUG is verbose and still never prints a
# code, a token or a signing key, but it does log every job tick.
LOG_LEVEL=INFO

# How often the job worker looks for due work, in seconds. Lower means new app
# announcements land sooner and the database is touched more often. There is
# little reason to change it.
SCHEDULER_TICK_SECONDS=15
