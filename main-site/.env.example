# main-site/.env.example
#
# Every key the portal reads. In production these live in the Vercel project
# environment, Settings then Environment Variables, not in a file. Copy this to
# .env only for local development with `vercel dev`.
#
# .env is git ignored. This file is committed, so never put a real value in it.
#
# After changing anything here on Vercel, redeploy. Serverless functions read
# the environment at cold start, so an existing warm instance keeps the old value.


# --- Supabase -----------------------------------------------------------------

# Where to find it: supabase.com, open the project, then Project Settings,
# Data API. Copy the "Project URL". It looks like https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Where to find it: same page, under Project API keys, the "service_role" key,
# NOT the anon key. It bypasses row level security, so it belongs only in a
# server environment. If it ever leaks, rotate it on that page immediately.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

# Which browser origins may fetch a guest signing key. Comma separated, no
# trailing slashes. Leave it empty to allow any origin, which is what a fresh
# project does. A request that sends no Origin header is never blocked by this,
# so it does not affect server to server callers.
ALLOWED_ORIGINS=https://uwuapps.org


# --- Telegram, required for account linking and the second factor -------------
# All four of these are set up in telegram-bot/SETUP.md. Until they are present,
# /api/telegram and /api/auth/magic will not work.

# Where to find it: message @BotFather in Telegram, send /newbot, and copy the
# token it hands back. It is also in .env on the VPS, and the two must match.
# The portal needs its own copy because it sends the approval prompt and the
# sign in code directly through the Bot API, which is what keeps the VPS off
# the public internet.
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Where to find it: the username you chose in the same /newbot conversation,
# without the leading @. Used to build the https://t.me/<name>?start=link_<code>
# deep link that the Settings tab opens. Keeping it here is why a rename is a
# one line change rather than an edit in three files.
TELEGRAM_BOT_USERNAME=your_bot_username

# How to make it: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then put the same value in telegram-bot/.env on the VPS. This is what proves
# a call to /api/telegram really came from the bot. It opens the four bot
# actions and nothing else, so it cannot unlink an account even by accident.
TELEGRAM_BOT_SHARED_SECRET=replace_me_with_64_hex_characters

# How to make it: python3 -c "import secrets; print(secrets.token_hex(32))"
# A fresh, different value from the one above. It is the key one time codes and
# sign in tokens are HMACed with, so nothing reversible is ever stored. This one
# lives only here, never on the VPS. Changing it invalidates every live code and
# every waiting sign in, which is a fine emergency response and a bad routine.
MFA_CODE_PEPPER=replace_me_with_a_different_64_hex_characters

# The canonical origin of the site, no trailing slash. Used to build the Sign in
# button URL that goes into the code message. It must be the host people
# actually reach the portal on, or that button lands nowhere.
PORTAL_ORIGIN=https://uwuapps.org
